            } else {
                searchParams.days = 1;
            }

            searchParams.pickup = document.getElementById('heroPickup').value;
            searchParams.dropoff = document.getElementById('heroDropoff').value;
            searchParams.service = document.getElementById('heroService').value;
            searchParams.delivery = document.getElementById('heroDelivery').value;

            const baseRate = searchParams.service === 'Dengan Driver' ? selectedCar.rateDriver : selectedCar.rateLepasKunci;
            const carRateTotal = baseRate * searchParams.days;
            
            let deliveryFee = 0;
            if (searchParams.delivery === 'Antar Alamat Tualang') deliveryFee = 50000;
            if (searchParams.delivery === 'Bandara SSK II Pekanbaru') deliveryFee = 150000;

            const deposit = searchParams.service === 'Dengan Driver' ? 0 : 500000;
            const grandTotal = carRateTotal + deliveryFee + deposit;

            document.getElementById('heroDisplayDays').innerText = `${searchParams.days} Hari`;
            document.getElementById('heroDisplayTotal').innerText = `Rp ${grandTotal.toLocaleString('id-ID')}`;
        }

        function handleHeroSearch(e) {
            e.preventDefault();
            updateHeroCalc();
            openBookingModal(selectedCar.id);
        }

        // RENDER FLEET CATALOG
        function renderFleet() {
            const grid = document.getElementById('fleetGrid');
            grid.innerHTML = '';

            const filtered = fleetData.filter(car => activeCategory === 'all' || car.category === activeCategory);

            filtered.forEach(car => {
                const card = document.createElement('div');
                card.className = "bg-navy-900 border border-slate-800 rounded-2xl overflow-hidden hover:border-amber-500/40 transition duration-300 flex flex-col justify-between group";
                card.innerHTML = `
                    <div>
                        <div class="relative h-48 overflow-hidden bg-navy-950">
                            <img src="${car.img}" alt="${car.name}" class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
                            <span class="absolute top-3 right-3 bg-navy-950/90 backdrop-blur-md px-2.5 py-1 rounded-full text-[10px] font-bold text-amber-400 border border-amber-500/30 uppercase">
                                ${car.transmission}
                            </span>
                        </div>
                        
                        <div class="p-5 space-y-4">
                            <h3 class="font-bold text-white text-base">${car.name}</h3>
                            
                            <div class="flex items-center gap-4 text-xs text-slate-400">
                                <span><i class="fa-solid fa-users text-amber-500 mr-1"></i> ${car.capacity}</span>
                                <span><i class="fa-solid fa-gas-pump text-amber-500 mr-1"></i> ${car.fuel}</span>
                                <span><i class="fa-solid fa-snowflake text-amber-500 mr-1"></i> AC Double</span>
                            </div>

                            <div class="border-t border-slate-800 pt-3 flex justify-between items-end">
                                <div>
                                    <span class="text-[10px] text-slate-400 block uppercase font-bold">Lepas Kunci</span>
                                    <span class="text-sm font-black text-white">Rp ${car.rateLepasKunci.toLocaleString('id-ID')}<span class="text-[10px] text-slate-400 font-normal">/hr</span></span>
                                </div>
                                <div class="text-right">
                                    <span class="text-[10px] text-slate-400 block uppercase font-bold"> + Driver</span>
                                    <span class="text-sm font-black text-amber-500">Rp ${car.rateDriver.toLocaleString('id-ID')}<span class="text-[10px] text-slate-400 font-normal">/hr</span></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="p-5 pt-0 grid grid-cols-2 gap-2">
                        <button onclick="openBookingModal(${car.id})" class="w-full py-2.5 rounded-xl bg-navy-800 text-white font-bold text-xs hover:bg-slate-800 border border-slate-700 transition">
                            Spesifikasi
                        </button>
                        <button onclick="openBookingModal(${car.id})" class="w-full py-2.5 rounded-xl bg-amber-500 text-navy-950 font-black text-xs uppercase tracking-wider hover:bg-amber-600 transition shadow-md shadow-amber-500/20">
                            Pesan (WA)
                        </button>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        function filterCategory(cat) {
            activeCategory = cat;
            document.querySelectorAll('.cat-btn').forEach(btn => {
                btn.className = "cat-btn px-4 py-2 text-xs font-bold rounded-lg text-slate-400 hover:text-white transition";
            });
            document.getElementById(`tab-${cat}`).className = "cat-btn px-4 py-2 text-xs font-bold rounded-lg bg-amber-500 text-navy-950 transition";
            renderFleet();
        }

        // BOOKING MODAL LOGIC
        function openBookingModal(carId) {
            selectedCar = fleetData.find(c => c.id === carId);
            updateHeroCalc();

            document.getElementById('modalCarImg').src = selectedCar.img;
            document.getElementById('modalCarName').innerText = selectedCar.name;
            document.getElementById('modalCarTrans').innerText = selectedCar.transmission;
            document.getElementById('modalCarCapacity').innerText = selectedCar.capacity;

            const baseRate = searchParams.service === 'Dengan Driver' ? selectedCar.rateDriver : selectedCar.rateLepasKunci;
            document.getElementById('modalDailyRate').innerText = `Rp ${baseRate.toLocaleString('id-ID')} / hari (${searchParams.service})`;

            const carRateTotal = baseRate * searchParams.days;
            let deliveryFee = 0;
            if (searchParams.delivery === 'Antar Alamat Tualang') deliveryFee = 50000;
            if (searchParams.delivery === 'Bandara SSK II Pekanbaru') deliveryFee = 150000;

            const deposit = searchParams.service === 'Dengan Driver' ? 0 : 500000;
            const grandTotal = carRateTotal + deliveryFee + deposit;

            document.getElementById('calcDays').innerText = `${searchParams.days} Hari`;
            document.getElementById('calcServiceMode').innerText = searchParams.service;
            document.getElementById('calcSubtotal').innerText = `Rp ${carRateTotal.toLocaleString('id-ID')}`;
            document.getElementById('calcDelivery').innerText = `Rp ${deliveryFee.toLocaleString('id-ID')}`;
            document.getElementById('calcDeposit').innerText = `Rp ${deposit.toLocaleString('id-ID')}`;
            document.getElementById('calcTotal').innerText = `Rp ${grandTotal.toLocaleString('id-ID')}`;

            document.getElementById('bookingModal').classList.remove('hidden');
        }

        function closeBookingModal() {
            document.getElementById('bookingModal').classList.add('hidden');
        }

        function previewDoc(event, type) {
            const file = event.target.files[0];
            if (file) {
                docFiles[type] = file.name;
                const previewElem = document.getElementById(`${type}Preview`);
                previewElem.innerText = `✓ ${file.name}`;
                previewElem.classList.remove('hidden');
            }
        }

        // SUBMIT BOOKING & WHATSAPP DISPATCH
        function submitBooking(e) {
            e.preventDefault();

            const name = document.getElementById('custName').value;
            const phone = document.getElementById('custPhone').value;
            const nik = document.getElementById('custNik').value;
            const address = document.getElementById('custAddress').value;

            const baseRate = searchParams.service === 'Dengan Driver' ? selectedCar.rateDriver : selectedCar.rateLepasKunci;
            const carRateTotal = baseRate * searchParams.days;
            let deliveryFee = 0;
            if (searchParams.delivery === 'Antar Alamat Tualang') deliveryFee = 50000;
            if (searchParams.delivery === 'Bandara SSK II Pekanbaru') deliveryFee = 150000;

            const deposit = searchParams.service === 'Dengan Driver' ? 0 : 500000;
            const grandTotal = carRateTotal + deliveryFee + deposit;
            const bookingCode = 'TRC-' + Math.floor(1000 + Math.random() * 9000);

            // SAVE LOCAL STORAGE ORDER
            const newOrder = {
                id: bookingCode,
                carName: selectedCar.name,
                custName: name,
                custPhone: phone,
                pickup: searchParams.pickup.replace('T', ' '),
                dropoff: searchParams.dropoff.replace('T', ' '),
                days: searchParams.days,
                service: searchParams.service,
                delivery: searchParams.delivery,
                total: grandTotal,
                createdAt: new Date().toLocaleDateString('id-ID')
            };

            const currentOrders = JSON.parse(localStorage.getItem('tualang_user_orders') || '[]');
            currentOrders.unshift(newOrder);
            localStorage.setItem('tualang_user_orders', JSON.stringify(currentOrders));

            // FORMAT WHATSAPP MESSAGE
            const waText = 
`*RESERVASI SEWA MOBIL - TUALANG RENT CAR*
*Kode Booking:* ${bookingCode}

*DATA PEMESAN:*
• Nama Lengkap: ${name}
• No. WhatsApp: ${phone}
• NIK E-KTP: ${nik}
• Alamat Domisili: ${address}

*Rincian SEWA:*
• Unit Mobil: *${selectedCar.name}*
• Opsi Layanan: ${searchParams.service}
• Lokasi Penjemputan: ${searchParams.delivery}
• Tgl & Jam Ambil: ${searchParams.pickup.replace('T', ' ')}
• Tgl & Jam Kembali: ${searchParams.dropoff.replace('T', ' ')}
• Durasi: ${searchParams.days} Hari

*BIAYA & DEPOSIT:*
• Subtotal Sewa: Rp ${carRateTotal.toLocaleString('id-ID')}
• Biaya Antar/Jemput: Rp ${deliveryFee.toLocaleString('id-ID')}
• Security Deposit: Rp ${deposit.toLocaleString('id-ID')}
• *TOTAL BIAYA: Rp ${grandTotal.toLocaleString('id-ID')}*

*DOKUMEN SYARAT:*
• KTP: ${docFiles.ktp || 'Dikirimkan via Chat'}
• SIM A: ${docFiles.sim || 'Dikirimkan via Chat'}

Halo Admin, mohon konfirmasi ketersediaan unit dan rekening pembayaran DP. Terima kasih!`;

            const encodedWa = encodeURIComponent(waText);
            const waUrl = `https://wa.me/6281234567890?text=${encodedWa}`;

            closeBookingModal();
            window.open(waUrl, '_blank');
        }

        // USER ORDER STATUS MODAL
        function openMyOrdersModal() {
            const list = document.getElementById('myOrdersList');
            const orders = JSON.parse(localStorage.getItem('tualang_user_orders') || '[]');

            if(orders.length === 0) {
                list.innerHTML = `<p class="text-xs text-slate-400 text-center py-6">Belum ada riwayat booking online.</p>`;
            } else {
                list.innerHTML = orders.map(ord => `
                    <div class="p-4 rounded-xl bg-navy-950 border border-slate-800 space-y-2 text-xs">
                        <div class="flex justify-between items-center">
                            <span class="font-mono font-bold text-amber-500">${ord.id}</span>
                            <span class="text-[10px] text-slate-400">${ord.createdAt}</span>
                        </div>
                        <div class="text-white font-bold text-sm">${ord.carName}</div>
                        <div class="text-slate-400">${ord.service} • ${ord.delivery}</div>
                        <div class="text-slate-400">Jadwal: ${ord.pickup} s/d ${ord.dropoff} (${ord.days} Hari)</div>
                        <div class="flex justify-between border-t border-slate-800 pt-2 text-slate-300">
                            <span>Total Pembayaran:</span>
                            <span class="font-bold text-amber-400">Rp ${ord.total.toLocaleString('id-ID')}</span>
                        </div>
                    </div>
                `).join('');
            }

            document.getElementById('myOrdersModal').classList.remove('hidden');
        }

        function closeMyOrdersModal() {
            document.getElementById('myOrdersModal').classList.add('hidden');
        }
    </script>
</body>
</html>
